[% USE raw %]
[% USE Asset %]
[% USE date %]
[% USE KohaDates %]
[% USE ItemTypes %]
[% USE Branches %]
[% USE Desks %]
[% USE Koha %]
[% USE AuthorisedValues %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title>Koha &rsaquo; Circulation &rsaquo; Demandes magasin</title>
[% INCLUDE 'doc-head-close.inc' %]
<style type="text/css"> 
	p { margin-top: 0; }
	#warehouse-request-tabs table {
      width: 100%;
   }
   .wr-date {
      white-space: nowrap;
      text-align: right;
   }
   #warehouse-requests-waiting-table .wr-waiting .wr-date .toolate {
      color: tomato;
      font-weight: 700;
   }
</style>
</head>

<body>
   [% WRAPPER 'header.inc' %]
        [% INCLUDE 'cat-search.inc' %]
    [% END %]
   
    [% WRAPPER 'sub-header.inc' %]
        [% WRAPPER breadcrumbs %]
            [% WRAPPER breadcrumb_item %]
                <a href="/cgi-bin/koha/circ/circulation-home.pl">Circulation</a>
            [% END %]
            [% WRAPPER breadcrumb_item bc_active= 1 %]
                <a href="#">Demandes Magasin</a>
            [% END %]
        [% END %]
    [% END %]

    <div id="wrm-addbarcode" class="modal fade block" aria-hidden='true'>
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h3>Ajouter un code barre pour le document :</h3>
                </div>
                <div class="modal-body">
                    <ul>
                    </ul>
                </div>
                <div class="modal-footer">
                    <input name="wrm-barcode" id="wrm-barcode" value="" />
                    <button id="wrm-addbarcode-submit" class="btn btn-default"><i></i> Enregistrer</button>
                </div>
            </div>
        </div>
    </div>
    <div class="main container-fluid">
    <div class="row">
        <div class="col-sm-2 col-sm-pull-10">
            <aside>
                <div id="filters">
                    <form id="wr-filters-form" method="post">
                        [% INCLUDE 'csrf-token.inc' %]
                        <input type="hidden" name="class" value="Koha::Plugin::Fr::UnivRennes2::WRM" />
                        <input type="hidden" name="method" value="tool" />
                        
                        <fieldset class="brief">
                            <h4>Filtrer</h4>
                            <ol>
                                <li>
                                    <label for="branchcode">Site :</label>
                                    <select name="branchcode" id="branchcode">
                                        <option value="">Tous les sites</option>
                                        [% FOREACH b IN Branches.all(only_from_group => 1) %]
                                            [% IF b.branchcode == branchcode %]
                                                <option value="[% b.branchcode | html %]" selected="selected">[% b.branchname | html %]</option>
                                            [% ELSE %]
                                                <option value="[% b.branchcode | html %]">[% b.branchname | html %]</option>
                                            [% END %]
                                        [% END %]
                                    </select>
                                </li>
                                [% IF Koha.Preference('UseCirculationDesks') && Desks.all %]
                                <li>
                                    <label for="desk_id">Bureau :</label>
                                    <select name="desk_id" id="desk_id">
                                        <option value="">---</option>
                                        [% FOREACH d IN Desks.all %]
                                            [% IF d.desk_id == desk_id %]
                                                <option class="desk-[% d.branchcode | html %]" value="[% d.desk_id | html %]" selected="selected">[% d.desk_name | html %]</option>
                                            [% ELSE %]
                                                <option class="desk-[% d.branchcode | html %]" value="[% d.desk_id | html %]">[% d.desk_name | html %]</option>
                                            [% END %]
                                        [% END %]
                                    </select>
                                </li>
                                [% END %]
                            </ol>
                            <fieldset class="action">
                                <button type="submit" class="btn btn-default btn-sm">
                                    <i class="fa fa-refresh"></i> Mettre à jour
                                </button>
                            </fieldset>
                        </fieldset>
                    </form>
                </div> <!-- /#filters -->
                [% INCLUDE 'circ-nav.inc' %]
            </aside>
        </div> <!-- /.col-sm-2.col-sm-pull-10 -->

        <div class="col-sm-10 col-sm-push-2">
            <main>
                [% INCLUDE 'messages.inc' %]
                
                <h1>Demandes magasin</h1>

                [% WRAPPER tabs id="warehouse-request-tabs" %]
                    [% WRAPPER tabs_nav %]
                        [% WRAPPER tab_item tabname="warehouse-requests-pending" bt_active= 1 %]
                            <span>En attente</span>
                            <span class="count_badge">([% warehouse_requests_pending.count | html %])</span>
                        [% END %]
                        [% WRAPPER tab_item tabname="warehouse-requests-processing" %]
                            <span>En traitement</span>
                            <span class="count_badge">([% warehouse_requests_processing.count | html %])</span>
                        [% END %]
                        [% WRAPPER tab_item tabname="warehouse-requests-waiting" %]
                            <span>Disponibles</span>
                            <span class="count_badge">([% warehouse_requests_waiting.count | html %])</span>
                        [% END %]
                        [% WRAPPER tab_item tabname="warehouse-requests-canceled" %]
                            <span>Annulées</span>
                            <span class="count_badge" id="wr_canceled_count"></span>
                        [% END %]
                        [% WRAPPER tab_item tabname="warehouse-requests-completed" %]
                            <span>Terminées</span>
                            <span class="count_badge" id="wr_completed_count"></span>
                        [% END %]
                    [% END # /WRAPPER tabs_nav %]

                    [% WRAPPER tab_panels %]
                        [% WRAPPER tab_panel tabname="warehouse-requests-pending" bt_active= 1 %]
                            [% IF warehouse_requests_pending.count %]
                                <form id="f-wr-pending" name="f-wr-pending" class="wr-form" method="post" action="">
                                    [% INCLUDE 'csrf-token.inc' %]
                                    <input type="hidden" name="class" value="Koha::Plugin::Fr::UnivRennes2::WRM" />
                                    <input type="hidden" name="method" value="tool" />
                                    <input type="hidden" name="type" value="manual"/>
                                    <input type="hidden" name="reqtype" value="pending"/>
                                    
                                    
                                    <div class="page-section">
                                        <div id="status-wr-pending">
                                            <fieldset class="action">
                                                <label for="action">Marquer les éléments sélectionnés comme :</label>
                                                <select name="action" id="action">
                                                    <option value="process">En traitement</option>
                                                </select>
                                                <button type="submit" class="btn btn-primary">
                                                    <i></i> Valider et imprimer
                                                </button>
                                            </fieldset>
                                        </div> <!-- /#status-wr-pending -->
                                        
                                        <div id="warehouse-requests-pending">
                                            <table id="warehouse-requests-pending-table" class="table table-bordered table-striped">
                                                <thead>
                                                    <tr>
                                                        <th class="NoSort">
                                                            <input type="checkbox" id="select-all-pending">
                                                        </th>
                                                        <th>N°</th>
                                                        <th>Notice</th>
                                                        <th>Informations complémentaires</th>
                                                        <th>Site</th>
                                                        <th>Type de document</th>
                                                        <th>Cote</th>
                                                        <th>Code à barres</th>
                                                        <th>Adhérent</th>
                                                        <th>Dates</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    [% FOREACH wr IN warehouse_requests_pending %]
                                                    <tr>
                                                        <td>
                                                            <input type="checkbox" name="id" value="[% wr.id | html %]" class="selection">
                                                        </td>
                                                        <td>[% wr.id | html %]</td>
                                                        <td>
                                                            <a href="/cgi-bin/koha/catalogue/detail.pl?biblionumber=[% wr.biblionumber | uri %]" class="title">
                                                                [% wr.biblio.title | html %]
                                                            </a>
                                                            [% IF wr.biblio.author %]
                                                                <p class="author">par [% wr.biblio.author | html %]</p>
                                                            [% END %]
                                                            [% IF wr.biblio.biblioitem.isbn %]
                                                            <span class="results_summary isbn">
                                                                <span class="label">ISBN :</span> [% wr.biblio.biblioitem.isbn | html %]
                                                            </span>
                                                            [% END %]
                                                        </td>
                                                        <td>
                                                            [% IF wr.volume %]
                                                                <span class="label">Volume(s) :</span> [% wr.volume | html %]<br>
                                                                [% END %]
                                                            [% IF wr.issue %]
                                                            <span class="label">Numéro(s) :</span> [% wr.issue | html %]<br>
                                                            [% END %]
                                                            [% IF wr.date %]
                                                            <span class="label">Date :</span> [% wr.date | html %]<br>
                                                            [% END %]
                                                            [% IF wr.patron_notes %]
                                                            <span class="label">Autre information :</span> [% wr.patron_notes | html %]
                                                            [% END %]
                                                        </td>
                                                        <td>[% Branches.GetName(wr.item.holdingbranch) | html %]</td>
                                                        <td>[% ItemTypes.GetDescription(wr.item.effective_itemtype) | html %]</td>
                                                        <td>
                                                            [% IF wr.item.location %]
                                                                <span class="location">
                                                                    [% AuthorisedValues.GetDescriptionByKohaField(kohafield => 'items.location', authorised_value => wr.item.location) | html %]
                                                                </span>
                                                            [% END %]
                                                            [% wr.item.itemcallnumber | html %]
                                                        </td>
                                                        <td>
                                                            <a href="/cgi-bin/koha/catalogue/moredetail.pl?biblionumber=[% wr.biblionumber | uri %]&itemnumber=[% wr.itemnumber | uri %]">
                                                                [% wr.item.barcode | html %]
                                                            </a>
                                                        </td>
                                                        <td>
                                                            <a href="/cgi-bin/koha/members/moremember.pl?borrowernumber=[% wr.borrower.borrowernumber | uri %]">
                                                                [% wr.borrower.surname | html %][% IF wr.borrower.firstname %], [% wr.borrower.firstname | html %][% END %]
                                                            </a>
                                                            [% IF wr.patron_name %]
                                                                <br><span class="patron_name">[% wr.patron_name | html %]</span>
                                                            [% END %]
                                                            [% IF wr.borrower.phone %]
                                                                <br>[% wr.borrower.phone | html %]
                                                                [% END %]
                                                            </td>
                                                            <td>
                                                                <span class="label">Création :</span> 
                                                                [% wr.created_on | $KohaDates with_hours => 1 %]<br>
                                                                <span class="label">Mise à jour :</span> 
                                                                [% wr.updated_on | $KohaDates with_hours => 1 %]
                                                            </td>
                                                        </tr>
                                                    [% END %]
                                                </tbody>
                                            </table>
                                        </div> <!-- /#warehouse-requests-pending -->
                                    </div> <!-- /.page-section -->

                                </form>
                            [% ELSE %]
                                <div class="dialog message">
                                    Il n'y a pas de demande en attente actuellement.
                                </div>
                            [% END %]
                        [% END # /WRAPPER tab_panel %]

                        [% WRAPPER tab_panel tabname="warehouse-requests-processing" %]
                            [% IF warehouse_requests_processing.count %]
                                <div class="btn-toolbar">
                                    <a href="/receive.pl" class="btn btn-danger btn-lg">
                                        <i class="fa fa-rocket"></i> Faire la réception ou déclarer le document manquant
                                    </a>
                                </div>

                                <div class="page-section">
                                    <table id="warehouse-requests-processing-table" class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th>N°</th>
                                                <th>Notice</th>
                                                <th>Informations complémentaires</th>
                                                <th>Site</th>
                                                <th>Type de document</th>
                                                <th>Cote</th>
                                                <th>Code à barres</th>
                                                <th>Code temporaire</th>
                                                <th>Adhérent</th>
                                                <th>Dates</th>
                                                <th class="NoSort">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            [% FOREACH wr IN warehouse_requests_processing %]
                                            <tr>
                                                <td>[% wr.id | html %]</td>
                                                <td>
                                                    <a href="/cgi-bin/koha/catalogue/detail.pl?biblionumber=[% wr.biblionumber | uri %]" class="title">
                                                        [% wr.biblio.title | html %]
                                                    </a>
                                                    [% IF wr.biblio.author %]
                                                        <p class="author">par [% wr.biblio.author | html %]</p>
                                                    [% END %]
                                                </td>
                                                <td>
                                                    [% IF wr.volume %]
                                                        <span class="label">Volume(s) :</span> [% wr.volume | html %]<br>
                                                    [% END %]
                                                    [% IF wr.issue %]
                                                        <span class="label">Numéro(s) :</span> [% wr.issue | html %]<br>
                                                    [% END %]
                                                    [% IF wr.date %]
                                                        <span class="label">Date :</span> [% wr.date | html %]<br>
                                                    [% END %]
                                                    [% IF wr.patron_notes %]
                                                        <span class="label">Autre information :</span> [% wr.patron_notes | html %]
                                                    [% END %]
                                                </td>
                                                <td>[% Branches.GetName(wr.item.holdingbranch) | html %]</td>
                                                <td>[% ItemTypes.GetDescription(wr.item.effective_itemtype) | html %]</td>
                                                <td>
                                                    [% IF wr.item.location %]
                                                        <span class="location">
                                                            [% AuthorisedValues.GetDescriptionByKohaField(kohafield => 'items.location', authorised_value => wr.item.location) | html %]
                                                        </span>
                                                    [% END %]
                                                    [% wr.item.itemcallnumber | html %]
                                                </td>
                                                <td>[% wr.item.barcode | html %]</td>
                                                <td>[% 574000000000 + wr.id | html %]</td>
                                                <td>
                                                    <a href="/cgi-bin/koha/members/moremember.pl?borrowernumber=[% wr.borrower.borrowernumber | uri %]">
                                                        [% wr.borrower.surname | html %][% IF wr.borrower.firstname %], [% wr.borrower.firstname | html %][% END %]
                                                    </a>
                                                    [% IF wr.patron_name %]
                                                        <br><span class="patron_name">[% wr.patron_name | html %]</span>
                                                    [% END %]
                                                    [% IF wr.borrower.phone %]
                                                        <br>[% wr.borrower.phone | html %]
                                                    [% END %]
                                                </td>
                                                <td>
                                                    <span class="label">Création :</span> 
                                                    [% wr.created_on | $KohaDates with_hours => 1 %]<br>
                                                    <span class="label">Mise à jour :</span> 
                                                    [% wr.updated_on | $KohaDates with_hours => 1 %]
                                                </td>
                                                <td>
                                                    <button type="button" class="btn btn-default btn-xs wr-print-request" data-id="[% wr.id | html %]">
                                                        <i class="fa fa-print"></i> Imprimer
                                                    </button>
                                                </td>
                                            </tr>
                                            [% END %]
                                        </tbody>
                                    </table>
                                </div> <!-- /.page-section -->
                            [% ELSE %]
                                <div class="dialog message">
                                    Il n'y a pas de demande en traitement actuellement.
                                </div>
                            [% END %]
                        [% END # /WRAPPER tab_panel %]

                        [% WRAPPER tab_panel tabname="warehouse-requests-waiting" %]
                            [% IF warehouse_requests_waiting.count %]
                                <form id="f-wr-scan-waiting" method="post" action="/cgi-bin/koha/plugins/run.pl" autocomplete="off" class="validated">
                                    [% INCLUDE 'csrf-token.inc' %]
                                    <input type="hidden" name="class" value="Koha::Plugin::Fr::UnivRennes2::WRM" />
                                    <input type="hidden" name="method" value="tool" />
                                    <input type="hidden" name="type" value="scan"/>
                                    <input type="hidden" name="reqtype" value="warehouse-requests-waiting"/>
                                    <input type="hidden" name="action" value="wait"/>
                                    
                                    <fieldset class="brief">
                                        <legend>Ajouter une demande</legend>
                                        <ol>
                                            <li>
                                                <label for="id" class="required">Code à barres :</label>
                                                <input type="text" name="id" id="id" size="14" class="focus" required="required"/>
                                            </li>
                                        </ol>
                                        <fieldset class="action">
                                            <button type="submit" class="btn btn-default">
                                                <i></i> Valider
                                            </button>
                                        </fieldset>
                                    </fieldset>
                                </form>

                                <form id="f-wr-waiting" method="post" name="f-wr-warehouse-requests-waiting" class="wr-form" action="" autocomplete="off">
                                    [% INCLUDE 'csrf-token.inc' %]
                                    <input type="hidden" name="class" value="Koha::Plugin::Fr::UnivRennes2::WRM" />
                                    <input type="hidden" name="method" value="tool" />
                                    <input type="hidden" name="type" value="manual"/>
                                    <input type="hidden" name="reqtype" value="waiting"/>

                                    <div class="page-section">
                                        <div id="warehouse-requests-waiting">
                                            <table id="warehouse-requests-waiting-table" class="table table-bordered table-striped">
                                                <thead>
                                                    <tr>
                                                        <th class="NoSort">
                                                            <input type="checkbox" id="select-all-waiting">
                                                        </th>
                                                        <th>N°</th>
                                                        <th>Notice</th>
                                                        <th>Informations complémentaires</th>
                                                        <th>Site</th>
                                                        <th>Type de document</th>
                                                        <th>Cote</th>
                                                        <th>Code à barres</th>
                                                        <th>Adhérent</th>
                                                        <th>Dates</th>
                                                        <th class="NoSort">Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    [% FOREACH wr IN warehouse_requests_waiting %]
                                                    <tr>
                                                        <td>
                                                            <input type="checkbox" name="id" value="[% wr.id | html %]" class="selection">
                                                        </td>
                                                        <td>[% wr.id | html %]</td>
                                                        <td>
                                                            <a href="/cgi-bin/koha/catalogue/detail.pl?biblionumber=[% wr.biblionumber | uri %]" class="title">
                                                                [% wr.biblio.title | html %]
                                                            </a>
                                                            [% IF wr.biblio.author %]
                                                            <p class="author">par [% wr.biblio.author | html %]</p>
                                                            [% END %]
                                                        </td>
                                                        <td>
                                                            [% IF wr.volume %]
                                                            <span class="label">Volume(s) :</span> [% wr.volume | html %]<br>
                                                            [% END %]
                                                            [% IF wr.issue %]
                                                                <span class="label">Numéro(s) :</span> [% wr.issue | html %]<br>
                                                                [% END %]
                                                                [% IF wr.date %]
                                                                <span class="label">Date :</span> [% wr.date | html %]<br>
                                                            [% END %]
                                                            [% IF wr.patron_notes %]
                                                            <span class="label">Autre information :</span> [% wr.patron_notes | html %]
                                                            [% END %]
                                                        </td>
                                                        <td>[% Branches.GetName(wr.item.holdingbranch) | html %]</td>
                                                        <td>[% ItemTypes.GetDescription(wr.item.effective_itemtype) | html %]</td>
                                                        <td>
                                                            [% IF wr.item.location %]
                                                            <span class="location">
                                                                [% AuthorisedValues.GetDescriptionByKohaField(kohafield => 'items.location', authorised_value => wr.item.location) | html %]
                                                                </span>
                                                            [% END %]
                                                            [% wr.item.itemcallnumber | html %]
                                                        </td>
                                                        <td>[% wr.item.barcode | html %]</td>
                                                        <td>
                                                            <a href="/cgi-bin/koha/members/moremember.pl?borrowernumber=[% wr.borrower.borrowernumber | uri %]">
                                                                [% wr.borrower.surname | html %][% IF wr.borrower.firstname %], [% wr.borrower.firstname | html %][% END %]
                                                            </a>
                                                            [% IF wr.patron_name %]
                                                                <br><span class="patron_name">[% wr.patron_name | html %]</span>
                                                            [% END %]
                                                            [% IF wr.borrower.phone %]
                                                            <br>[% wr.borrower.phone | html %]
                                                            [% END %]
                                                        </td>
                                                        <td>
                                                            <span class="label">Création :</span> 
                                                            [% wr.created_on | $KohaDates with_hours => 1 %]<br>
                                                            <span class="label">Mise à jour :</span> 
                                                            [% wr.updated_on | $KohaDates with_hours => 1 %]<br>
                                                            [% IF wr.deadline %]
                                                            [% SET today = date.format(date.now, '%Y%m%d') %]
                                                            [% SET deadline_str = wr.deadline.replace('-','') %]
                                                                [% IF deadline_str < today %]
                                                                <span class="error label">
                                                                [% ELSE %]
                                                                <span class="label">
                                                                    [% END %]
                                                                À chercher avant le : [% wr.deadline | $KohaDates %]</span>
                                                                [% END %]
                                                        </td>
                                                        <td>
                                                            <button type="button" class="btn btn-default btn-xs wr-print-request" data-id="[% wr.id | html %]">
                                                                <i class="fa fa-print"></i> Imprimer
                                                            </button>
                                                        </td>
                                                    </tr>
                                                    [% END %]
                                                </tbody>
                                            </table>
                                        </div> <!-- /#warehouse-requests-waiting -->
                                    </div> <!-- /.page-section -->
                                    
                                    <div id="status-wr-waiting">

                                        <fieldset class="action">
                                            <label for="action">Marquer les éléments sélectionnés comme :</label>
                                            <select name="action" id="action">
                                                <option value="">-- Choisir un état --</option>
                                                <option value="complete">Terminé</option>
                                                <option value="cancel">Annulé</option>
                                            </select>
                                            <label for="reason-wr-waiting">avec le message :</label>
                                            <select name="reason" id="reason-wr-waiting">
                                                <option value="">-- Choisir --</option>
                                                [% FOREACH reason IN reasonsloop %]
                                                <option value="[% reason.lib | html %]">[% reason.lib | html %]</option>
                                                [% END %]
                                                <option value="other">Autres...</option>
                                            </select>
                                            <span id="other-reason-wr-waiting" style="display:none;">
                                                <input type="text" name="other_reason" id="other_reason-wr-input-waiting" placeholder="Merci d'indiquer la raison ici..." size="31" />
                                            </span>
                                            <button type="submit" class="btn btn-default">
                                                <i></i> Valider
                                            </button>
                                        </fieldset>
                                    </div> <!-- /#status-wr-waiting -->
                                </form>
                                [% ELSE %]
                                <div class="dialog message">
                                    Il n'y a pas de demande disponible actuellement.
                                </div>
                                [% END %]
                        [% END # /WRAPPER tab_panel %]

                        [% WRAPPER tab_panel tabname="warehouse-requests-canceled" %]
                            <div class="dialog message" id="no-canceled-msg">
                                Il n'y a pas de demande annulée actuellement.
                            </div>
                            <button type="button" id="load-canceled-button" class="btn btn-default">
                                <i class="fa fa-file-text"></i> Afficher les demandes annulées
                            </button>
                            <div id="canceled-results" style="display:none;">
                                <!-- Les résultats seront chargés ici via AJAX -->
                            </div>
                        [% END # /WRAPPER tab_panel %]

                        [% WRAPPER tab_panel tabname="warehouse-requests-completed" %]
                            <form id="f-wr-scan-completed" method="post" action="/cgi-bin/koha/plugins/run.pl" autocomplete="off" class="validated">
                                [% INCLUDE 'csrf-token.inc' %]
                                <input type="hidden" name="class" value="Koha::Plugin::Fr::UnivRennes2::WRM" />
                                <input type="hidden" name="method" value="tool" />
                                <input type="hidden" name="type" value="scan"/>
                                <input type="hidden" name="reqtype" value="warehouse-requests-completed"/>
                                <input type="hidden" name="action" value="complete"/>
                                
                                <fieldset class="brief">
                                    <legend>Ajouter une demande</legend>
                                    <ol>
                                        <li>
                                            <label for="barcode-completed" class="required">Code à barres :</label>
                                            <input type="text" name="id" id="barcode-completed" size="14" class="focus" required="required"/>
                                        </li>
                                    </ol>
                                    <fieldset class="action">
                                        <button type="submit" class="btn btn-default">
                                            <i></i> Valider
                                        </button>
                                    </fieldset>
                                </fieldset>
                            </form>

                            <div class="dialog message" id="no-completed-msg">
                                Il n'y a pas de demande terminée actuellement.
                            </div>
                            <button type="button" id="load-completed-button" class="btn btn-default">
                                <i class="fa fa-file-text"></i> Afficher les demandes terminées
                            </button>
                            <div id="completed-results" style="display:none;">
                                <!-- Les résultats seront chargés ici via AJAX -->
                            </div>
                        [% END # /WRAPPER tab_panel %]
                    [% END # /WRAPPER tab_panels %]
                [% END # /WRAPPER tabs %]

            </main>
        </div> <!-- /.col-sm-10.col-sm-push-2 -->

    </div> <!-- /.row -->
</div> <!-- /.main.container-fluid -->
   
   
[% MACRO jsinclude BLOCK %]
    [% INCLUDE 'datatables.inc' %]
    <script>

    $(document).ready(function(){

        var csrf_token = $('input[name="csrf_token"]').val();
        
        // On change manuellement les referer vers set-library.pl
        // Sinon le renvoi est complètement pété
        $('a[href*="set-library.pl"]').each(function() {
            $(this).attr('href', '/cgi-bin/koha/circ/set-library.pl?oldreferer=' 
                + encodeURIComponent('/cgi-bin/koha/plugins/run.pl?class=Koha::Plugin::Fr::UnivRennes2::WRM&method=tool')
            );
        });


        var checkboxes = document.getElementsByTagName('input');
        
        for (var i=0; i<checkboxes.length; i++)  {
            if (checkboxes[i].type == 'checkbox')   {
                checkboxes[i].checked = false;
            }
        }
        
        $('#select-all-pending').click(function(e){
            var isChecked = $(this).prop('checked');
            $("#warehouse-requests-pending-table input[type='checkbox'][name='id']").prop('checked', isChecked);
        });

        // $('#warehouse-request-tabs').tabs({
        //     // Correct table sizing for tables hidden in tabs
        //     // http://www.datatables.net/examples/api/tabs_and_scrolling.html
        //     "activate": function(event, ui) {
        //         $( $.fn.dataTable.tables( true ) ).DataTable().columns.adjust();
        //     }
        // });
        
        $("#warehouse-requests-pending-table,#warehouse-requests-processing-table,#warehouse-requests-waiting-table").dataTable($.extend(true, {}, dataTablesDefaults, {
                "aoColumnDefs": [
                    { "aTargets": [0, -1], "bSortable": false, "bSearchable": false },
                ],
            }));

            if(window.location.hash) {
                var hash = window.location.hash.substring(1); 
                if($("#f-wr-"+hash+'').size() > 0){
                    console.log(hash);
                    $('#f-wr-'+hash+' #id').focus();
                }
            }  
            
            submitUpRequest();
            
            [% IF warehouse_requests_pending.count %]
            $(".wr-pending-none").hide();
            $("#warehouse-requests-pending-table  input[type='checkbox']").prop('checked', true);
            $(".wr-requests-pending_table_controls .SelectAll").click(function(e){
                e.preventDefault();
                $("#warehouse-requests-pending-table input[type='checkbox']").prop('checked', true);
            });
            $(".wr-requests-pending_table_controls .ClearAll").click(function(e){
            e.preventDefault();
            $("#warehouse-requests-pending-table input[type='checkbox']").prop('checked', false);
        });
        
        [% END %]
        
        [% IF warehouse_requests_processing.count %]
        $(".wr-processing-none").hide();
        $(".wr-requests-processing_table_controls .SelectAll").click(function(e){
            e.preventDefault();
            $("#warehouse-requests-processing-table input[type='checkbox']").prop('checked', true);
        });
        $(".wr-requests-processing_table_controls .ClearAll").click(function(e){
            e.preventDefault();
            $("#warehouse-requests-processing-table input[type='checkbox']").prop('checked', false);
        });
        $("#other_reason-wr-processing").hide();
        $("#reason-wr-processing").change(function(){
            if($(this).val() == "other"){
                $(this).hide();
                    $("#other_reason-wr-processing").show();
                }
            });
            [% END %]
            
            [% IF warehouse_requests_waiting.count %]
            $(".wr-waiting-none").hide();
            $(".wr-requests-waiting_table_controls .SelectAll").click(function(e){
            e.preventDefault();
            $("#warehouse-requests-waiting-table input[type='checkbox']").prop('checked', true);
        });
            $(".wr-requests-waiting_table_controls .ClearAll").click(function(e){
                e.preventDefault();
                $("#warehouse-requests-waiting-table input[type='checkbox']").prop('checked', false);
            });
            $("#other_reason-wr-waiting").hide();
            $("#reason-wr-waiting").change(function(){
                if($(this).val() == "other"){
                    $(this).hide();
                    $("#other_reason-wr-waiting").show();
                }
            }); 
            [% END %]
            
            $(".wr-canceled-none").hide();
            $(".wr-completed-none").hide();
            
            $("a[href*=back]").click(function(){
                var sid = $(this).attr("href").replace(/#back/,"");
                $("#reason"+sid).show().find("option[value='']").attr("selected","selected");
                $("#other_reason"+sid).hide();
            });
            
            $(document).on("click", "button.wr-print-request", function(e) {
                e.preventDefault();
                var id = $(this).data('id');
                //PrintSlip('/cgi-bin/koha/plugins/run.pl?class=Koha%3A%3APlugin%3A%3AFr%3A%3AUnivRennes2%3A%3AWRM&method=tool&op=ticket&id='+id);
                //PrintSlip('/cgi-bin/koha/circ/printslip.pl?reserves='+id);
                var baseURL = window.location.origin;
                var fullURL = baseURL + '/cgi-bin/koha/plugins/run.pl?class=Koha%3A%3APlugin%3A%3AFr%3A%3ABulac%3A%3ABulacReports&method=tool&sub=printwrm&id=' + id;
                PrintSlip(fullURL);
                return false;
            });
            
            $("a#load-completed-button").click(function() {
                getList($(this),'completed');
            });
            $("a#load-canceled-button").click(function() {
                getList($(this),'canceled');
            });

    });
        
        
        
    function submitUpRequest() {
        var csrf_token = $('input[name="csrf_token"]').val();
        $('.wr-form').on('submit', function(e) { //use on if jQuery 1.7+
            e.preventDefault();  //prevent form from submitting
            var type = $(this).children('input[name="type"]').val();
            var reqtype = $(this).children('input[name="reqtype"]').val(); 
            if(type === 'scan') {
                var action = $("#f-wr-"+reqtype+" #action").val();
                var id = $("#f-wr-"+reqtype+" #id").val();
                console.log(action);
                console.log(id);
                if(id != "") {
                    $.ajax({
                        type: "POST",
                        url: '/api/v1/contrib/wrm/update_status',
                        data: {
                            action: action,
                            id: id,
                            notes: "",
                            csrf_token: csrf_token
                        },
                        dataType: 'json',
                        async: false,
                        success: function (data, textStatus, jqXHR) {
                            if (data.success) {
                                alert("La demande "+id+" a été ajoutée");
                            } else {
                                alert("La requête n'a pu aboutir.");
                            };
                        },
                        error: function ( jqXHR, textStatus, errorThrown ) {
                            var data = JSON.parse( jqXHR.responseText );
                            alert( $("<div/>").html(data.error).text() );
                        }
                    });
                }
                window.location.hash = "#"+reqtype;
            } else if(type === 'manual') {
                var action = $("#status-wr-"+reqtype+" #action").find(":selected").val();
                // BUGFIX: On force action= process pour la table pending ; il faudra traiter ça plus proprement 
                if (reqtype === 'pending') {
                    action = 'process';
                }

                var reason = "";
                if($("#reason-wr-"+reqtype).length > 0) {
                    reason = $("#reason-wr-"+reqtype).find(":selected").val(); 
                    if(reason === "other"){
                        reason = $("#select-other_reason-wr-"+reqtype).val();
                    }
                }
                console.log(action);
                var reqids = '';
                $("#warehouse-requests-"+reqtype+" input:checkbox[name=id]:checked").each(function() {
                    console.log( $(this).val());
                    reqids += $(this).val() + ',';
                    $.ajax({
                        type: "POST",
                        url: '/api/v1/contrib/wrm/update_status',
                        data: {
                            action: action,
                            id: $(this).val(),
                            notes: reason,
                            csrf_token: csrf_token
                        },
                        dataType: 'json',
                        cache: false,
                        async: false,
                        success: function (data, textStatus, jqXHR) {
                            var errors = {
                                0 : "La requête n'a pu aboutir.",
                                1 : "La demande "+id+" a été ajoutée",
                            };
                            console.log(errors[data.success]);                                                  
                        },
                        error: function (jqXHR, textStatus, errorThrown) {
                            alert("La requête n'a pu aboutir");
                        }
                    });
                });
                if (action === 'process') {
                    var baseURL = window.location.origin;
                    var fullURL = baseURL + '/cgi-bin/koha/plugins/run.pl?class=Koha%3A%3APlugin%3A%3AFr%3A%3ABulac%3A%3ABulacReports&method=tool&sub=printwrm&id=' + reqids;
                    window.open(fullURL);
                    //window.open('/cgi-bin/koha/circ/printslip.pl?reserves=' + reqids);                    
                    }
                    window.location.hash = "#warehouse-requests-"+reqtype;
                }
            setTimeout(function() {              
                window.location.reload();
            },0);
            /*this.submit();*/
        });
    }
    

    
    function PrintSlip(link) {
        window.open(link);
    }
    
    function Cancel( id, a ) {
        var csrf_token = $('input[name="csrf_token"]').val();
        notes = prompt(_("Raison de l'annulation:"));
        if ( notes == null ) {
            return;
        }
        var table_row = a.closest('tr').clone();
        table_row.find('.wr-cancel-request').remove();
        
        
        a.closest('td').prepend('<img src="[% interface %]/[% theme %]/img/loading-small.gif"/>');
        a.closest('div').hide();
        $.ajax({
            type: "POST",
            url: '/api/v1/contrib/wrm/update_status',
            data: {
                action: 'cancel',
                id: id,
                notes: notes,
                csrf_token: csrf_token
            },
            success: function( data ) {
                a.closest('tr').remove();
                $("#warehouse-requests-canceled-table").append( table_row );
                $("#warehouse-requests-canceled-table .wr-processing-none").hide();
                UpdateTabCounts()
            },
            dataType: 'json'
        });
    }
    
    function Process( id, a ) {
        var csrf_token = $('input[name="csrf_token"]').val();
        var table_row = a.closest('tr').clone();
        table_row.find('.wr-process-request').remove();
        table_row.find('.wr-process-print-request').remove();
        table_row.find('.wr-process-print-request').remove();
        table_row.find('.wr-actions .dropdown  .dropdown-menu li').prepend('<a class="wr-waiting-request" href="#" onclick="Wait( '+id+', $(this) ); return false;"><i class="icon-ok-circle"></i>Wait request</a>')
        a.closest('td').prepend('<img src="[% interface %]/[% theme %]/img/loading-small.gif"/>');
        a.closest('div').hide();
        $.ajax({
            type: "POST",
            url: '/api/v1/contrib/wrm/update_status',
            data: {
                action: 'process',
                id: id,
                csrf_token: csrf_token,
            },
            success: function( data ) {
                a.closest('tr').remove();
                $("#warehouse-requests-processing-table").append( table_row );
                $("#warehouse-requests-processing-table .wr-processing-none").hide();
                UpdateTabCounts()
            },
            dataType: 'json'
        });
    }
    
    function Wait( id, a ) {
        var csrf_token = $('input[name="csrf_token"]').val();
        var table_row = a.closest('tr').clone();
        table_row.find('.wr-waiting-request').remove();
        table_row.find('.wr-actions .dropdown  .dropdown-menu li').prepend('<a class="wr-completed-request" href="#" onclick="Completed( '+id+', $(this) ); return false;"><i class="icon-ok-circle"></i>Complete request</a>')
        
        a.closest('td').prepend('<img src="[% interface %]/[% theme %]/img/loading-small.gif"/>');
        a.closest('div').hide();
        $.ajax({
            type: "POST",
            url: '/api/v1/contrib/wrm/update_status',
            data: {
                action: 'wait',
                id: id,
                csrf_token: csrf_token
            },
            success: function( data ) {
                a.closest('tr').remove();
                $("#warehouse-requests-waiting-table").append( table_row );
                $("#warehouse-requests-waiting-table .wr-waiting-none").hide();
                UpdateTabCounts()
            },
            dataType: 'json'
        });
    }
    
    function Complete( id, a ) {
        var csrf_token = $('input[name="csrf_token"]').val();
        var table_row = a.closest('tr').clone();
        table_row.find('.wr-complete-request').remove();
        
        a.closest('td').prepend('<img src="[% interface %]/[% theme %]/img/loading-small.gif"/>');
        a.closest('div').hide();
        $.ajax({
            type: "POST",
            url: '/api/v1/contrib/wrm/update_status',
            data: {
                action: 'complete',
                id: id,
                csrf_token: csrf_token
            },
            success: function( data ) {
                a.closest('tr').remove();
                $("#warehouse-requests-completed-table").append( table_row );
                $("#warehouse-requests-completed-table .wr-waiting-none").hide();
                UpdateTabCounts()
            },
            dataType: 'json'
        });
    }
    
    /**
     *  displayOther.
     *  This function display the select or an textaera to write a reason.
     */
    function displayOther(id,show,hide){
        $("#"+hide+id).hide();
        $("#"+show+id).show();
    }
    
    
    function UpdateTabCounts() {
        var pending_count = $('#warehouse-requests-pending-table').DataTable().rows().count();
        $("#wr_pending_count").html( pending_count );
        if ( pending_count == 0 ) $(".wr-pending-none").show();
        
        var processing_count = $('#warehouse-requests-processing-table').DataTable().rows().count();
        $("#wr_processing_count").html( processing_count );
        if ( processing_count == 0 ) $(".wr-processing-none").show();
        
        var waiting_count = $('#warehouse-requests-waiting-table').DataTable().rows().count();
        $("#wr_waiting_count").html( waiting_count );
        if ( waiting_count == 0 ) $(".wr-waiting-none").show();
        
        if ($('#warehouse-requests-completed-table').length > 0) {
            var completed_count = $('#warehouse-requests-completed-table').DataTable().rows().count();
            $("#wr_completed_count").html( ' ('+completed_count+')' );
            if ( completed_count == 0 ) $(".wr-completed-none").show();
        }
        
        if ($('#warehouse-requests-canceled-table').length > 0) {
            var canceled_count = $('#warehouse-requests-canceled-table').DataTable().rows().count();
            $("#wr_canceled_count").html( ' ('+canceled_count+')' );
            if ( canceled_count == 0 ) $(".wr-canceled-none").show();
        }
    }
    
    function getList(button, status) {
        if (status != 'completed' && status != 'canceled') return;
        var parent = $(button).parent();
        $(button).remove();
        parent.append('<div class="loading">Chargement...</div>');
        $.ajax({
            type: "GET",
            url: '/api/v1/contrib/wrm/list/are/'+status.toUpperCase(),
            success: function( data ) {
                parent.find('.loading').remove();
                parent.append(`
                    <table id="warehouse-requests-`+status+`-table">
                    <thead>
                        <tr>
                            <th class="wr-id">N°</th>
                            <th class="wr-title">Notice</th>
                            <th class="wr-request">Informations complémentaires</th>
                            <th class="wr-holdingbranch">Site</th>
                            <th class="wr-itemtype">Type de document</th>
                            <th class="wr-callnumber">Cote</th>
                            <th class="wr-barcode">Code à barres</th>
                            <th class="wr-patron">Adhérent</th>
                            <th class="wr-date">Dates</th>`+
                                (status == 'canceled' ? '<th class="wr-notes">Motif</th>' : '')+
                                `<th class="wr-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                    </table>
                                `);
                $.each(data, function(i, wr) {
                    $('#warehouse-requests-'+status+'-table tbody').append(`
                    <tr class="wr-row wr-`+status+`">
                        <td class="wr-id">`+wr.id+`</td>
                        <td class="wr-title">
                            <p>
                                <a href="/cgi-bin/koha/catalogue/detail.pl?biblionumber=`+wr.biblionumber+`">
                                <strong>`+wr.biblio.title+`</strong>
                                </a>
                            </p>
                            <p>
                                <div class="wr-biblionumber content_hidden">`+wr.biblionumber+`</div>
                                <div class="wr-author">`+wr.biblio.author+`</div>
                            </p>
                        </td>
                        <td class="wr-request">`+
                                ( wr.volume ? '<p><strong>Volume(s)&nbsp;:</strong> '+wr.volume+'</p>' : '') +
                                ( wr.issue ? '<p><strong>Numéro(s)&nbsp;:</strong> '+wr.issue+'</p>' : '') +
                                ( wr.date ? '<p><strong>Date&nbsp;:</strong> '+wr.date+'</p>' : '') +
                                ( wr.patron_notes ? '<p><strong>Autre information&nbsp;:</strong> '+wr.patron_notes+'</p>' : '') +
                                                                            `</td>
                        <td class="wr-holdingbranch">`+wr.item.holdingbranch+`</td>
                        <td class="wr-itemtype">`+wr.item.itemtype+`</td>
                        <td class="wr-callnumber">`+
                                ( wr.item.location != '' ? '<em>'+wr.item.location+'</em> ' : '') +
                                                                            wr.item.itemcallnumber+
                                                                            `</td>
                        <td class="wr-barcode">`+wr.item.barcode+`</td>
                        <td class="wr-patron">
                            <p>
                                <a href="/cgi-bin/koha/members/moremember.pl?borrowernumber=`+wr.borrowernumber+`">`+
                                                                            wr.borrower.surname+(wr.borrower.firstname ? ', '+wr.borrower.firstname : '') +
                                                                            `</a>
                            </p>`+
                                ( wr.patron_name ? '<p>'+wr.patron_name+'</p>' : '') +
                                ( wr.borrower.phone ? '<p>'+wr.borrower.phone+'</p>' : '')+
                                                                            `</td>
                        <td class="wr-date">
                            <div>Création : `+(new Date(wr.created_on).toLocaleString())+`</div>
                            <div>Mise à jour : `+(new Date(wr.updated_on).toLocaleString())+`</div>
                        </td>`+
                                ( status == 'canceled' ? '<td class="wr-notes">' + ( wr.notes ? '<p><strong>'+wr.notes+'</strong></p>' : '' ) +'</td>' : '' )+
                                                                            `<td class="wr-actions">
                            <a class="wr-print-request btn btn-xs" href="#" id="`+wr.id+`">
                                <i class="fa fa-print"></i> Imprimer
                            </a>
                        </td>
                    </tr>
                            `);
                });
                // $("#warehouse-requests-"+status+"-table a.wr-print-request").click(function(e) {
                //     e.preventDefault();
                //     var id = $(this).attr('id');
                //     //PrintSlip('/cgi-bin/koha/plugins/run.pl?class=Koha%3A%3APlugin%3A%3AFr%3A%3AUnivRennes2%3A%3AWRM&method=tool&op=ticket&id='+id);
                //     var baseURL = window.location.origin;
                //     var fullURL = baseURL + '/cgi-bin/koha/plugins/run.pl?class=Koha%3A%3APlugin%3A%3AFr%3A%3ABulac%3A%3ABulacReports&method=tool&sub=printwrm&id=' + id;
                //     PrintSlip(fullURL);
                //     return false;
                // });
                $('#warehouse-requests-'+status+'-table').dataTable($.extend(true, {}, dataTablesDefaults, {
                    "aoColumnDefs": [
                        { "aTargets": [0, -1], "bSortable": false, "bSearchable": false },
                    ],
                }));
                UpdateTabCounts();
            },
            dataType: 'json'
        });
    }
    $("#warehouse-requests-processing-table input[type='checkbox']").change(function() {
        if (this.checked) {
            let wrmid = $(this).val();
            $("#wrm-addbarcode ul").empty();
            barcode = $("#wrm-barcode").val('');
            $.getJSON("/api/v1/contrib/wrm/get_itemnumber?wrmid=" + wrmid, function(res) {
                if (res.state === 'success') {
                    if (res.barcode === null) {
                        if (res.title) {
                            $("#wrm-addbarcode ul").append("<li>" + res.title + "</li>")
                        }
                        if (res.author) {
                            $("#wrm-addbarcode ul").append("<li>" + res.author + "</li>")
                        }
                        if (res.callnumber) {
                            $("#wrm-addbarcode ul").append("<li>" + res.callnumber + "</li>")
                        }
                        if (res.enumchron) {
                            $("#wrm-addbarcode ul").append("<li>" + res.enumchron + "</li>")
                        }
                        $("#wrm-addbarcode-submit").on('click', function () {
                            let barcode = $("#wrm-barcode").val();
                            $.getJSON("/api/v1/contrib/wrm/add_barcode?itemnumber=" + res.itemnumber + "&barcode=" + barcode, function(addbcres) {
                                if (addbcres.state === 'failed') {
                                    alert(addbcres.state + ": " + addbcres.error + ", request id: " + wrmid);
                                }
                                $('#wrm-addbarcode').modal('hide');
                                barcode = $("#wrm-barcode").val('');
                            });
                            $("#wrm-addbarcode-submit").off();
                        });
                        $('#wrm-addbarcode').modal({
                            show: true
                        });

                    }

                }
            });
        }
    });
   </script>
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]
