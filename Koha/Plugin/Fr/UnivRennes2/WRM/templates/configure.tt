[% USE raw %]
[% USE Asset %]
[% USE Koha %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
    <title>Koha: Warehouse Request Management Plugin: Configuration</title>
[% INCLUDE 'doc-head-close.inc' %]

<style>
    /* Styles génériques pour les listes de cases à cocher multiples */
    .checkbox-list-container {
        display: inline-block;
        width: max-content;
        min-width: 40%;
        max-width: 80%;
        max-height: 250px; /* Un peu plus petit que 400px pour éviter que le formulaire ne soit trop long vu qu'il y a 4 listes */
        overflow-y: auto;
        border: 1px solid #ccc;
        border-radius: 4px;
        background: #fff;
    }

    .koha-checkbox {
        padding: 0.6em 1em;
        border-bottom: 1px solid #e8e8e8;
    }

    .koha-checkbox:last-child {
        border-bottom: none;
    }

    .koha-checkbox:nth-child(even) {
        background-color: #f9f9f9;
    }

    fieldset.rows .koha-checkbox label {
        float: none;
        width: auto;
        text-align: left;
        margin: 0;
        cursor: pointer;
        display: grid;
        grid-template-columns: 1.4em 1fr;
        align-items: center;
        gap: 0.5em;
        font-weight: normal;
        white-space: nowrap;
    }

    .koha-checkbox input[type="checkbox"] {
        width: 1.2em;
        height: 1.2em;
        margin: 0;
        cursor: pointer;
    }

    .checkbox-description {
        white-space: nowrap;
        line-height: 1.6;
    }
</style>
</head>
<body>
    [% WRAPPER 'header.inc' %]
        [% INCLUDE 'prefs-admin-search.inc' %]
    [% END %]

    [% WRAPPER 'sub-header.inc' %]
        [% WRAPPER breadcrumbs %]
            [% WRAPPER breadcrumb_item %]
                <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a>
            [% END %]
            [% WRAPPER breadcrumb_item %]
                <a href="/cgi-bin/koha/plugins/run.pl?class=Koha%3A%3APlugin%3A%3AFr%3A%3AUnivRennes2%3A%3AWRM&method=tool"><span data-i18n-key="PLUGIN_NAME"></span> </a>
            [% END %]
            [% WRAPPER breadcrumb_item bc_active= 1 %]
                <a href="#"><span data-i18n-key="BREADCRUMBS_CONF"></span></a>
            [% END %]
        [% END %]
    [% END %]

    <div class="main container-fluid">
        <div class="row">
            <div class="col-sm-10 col-sm-push-2">
                <main>
                    [% IF config_success %]
                        <div class="alert alert-success">
                            <h3 data-i18n-key="SUCCESS_ALERT"></h3>
                            <p data-i18n-key="[% config_success %]"></p>
                        </div>
                    [% END %]
                    [% IF config_error %]
                        <div class="alert alert-danger">
                            <h3 data-i18n-key="ERROR_ALERT"></h3>
                            <p data-i18n-key="[% config_error %]"></p>
                        </div>
                    [% END %]                   
                    
                    <form method="post">
                        [% INCLUDE 'csrf-token.inc' %]
                        <input type="hidden" name="class" value="[% CLASS %]"/>
                        <input type="hidden" name="method" value="[% METHOD %]"/>
                        <input type="hidden" name="save" value="1" />

                        <!-- Premier bloc : Configuration -->
                        <fieldset class="rows">
                            <legend><h1 data-i18n-key="BREADCRUMBS_CONF"></h1></legend>
                            <ol>
                                <li>
                                    <label for="days_to_keep"><span data-i18n-key="REQUEST_MAX_PICKUP_DELAY"></span>: </label>
                                    <input type="number" id="days_to_keep" name="days_to_keep" value="[% days_to_keep %]" />
                                    <span class="hint" data-i18n-key="DAYS"></span>
                                </li>
                                <li>
                                    <label for="days_since_archived"><span data-i18n-key="ARCHIVE_AFTER"></span>: </label>
                                    <input type="number" id="days_since_archived" name="days_since_archived" value="[% days_since_archived %]" />
                                    <span class="hint" data-i18n-key="DAYS"></span>
                                </li>
                                
                                <!-- Sélection des bibliothèques -->
                                <li>
                                    <label><span data-i18n-key="ENABLED_BRANCH"></span>: </label>
                                    <div class="checkbox-list-container">
                                        [% FOREACH b IN branches %]
                                        <div class="koha-checkbox">
                                            <label>
                                                <input type="checkbox" name="warehouse_branches" value="[% b.branchcode %]" [% IF warehouse_branches.grep('^' _ b.branchcode _ '$').size %]checked="checked"[% END %] />
                                                <span class="checkbox-description">[% b.branchname | html %]</span>
                                            </label>
                                        </div>
                                        [% END %]
                                    </div>
                                </li>
                                
                                <li>
                                    <label for="warehouse_desks"><span data-i18n-key="ENABLED_DESKS"></span>: </label>
                                    <textarea id="warehouse_desks" name="warehouse_desks" rows="3" cols="40">[% warehouse_desks %]</textarea>
                                </li>
                                
                                <!-- Sélection des localisations -->
                                <li>
                                    <label><span data-i18n-key="ENABLED_LOC"></span>: </label>
                                    <div class="checkbox-list-container">
                                        [% FOREACH l IN locations %]
                                        <div class="koha-checkbox">
                                            <label>
                                                <input type="checkbox" name="warehouse_locations" value="[% l.code %]" [% IF warehouse_locations.grep('^' _ l.code _ '$').size %]checked="checked"[% END %] />
                                                <span class="checkbox-description">[% l.description | html %]</span>
                                            </label>
                                        </div>
                                        [% END %]
                                    </div>
                                </li>
                                
                                <!-- Sélection des types de document -->
                                <li>
                                    <label><span data-i18n-key="ENABLED_ITEMTYPES"></span>: </label>
                                    <div class="checkbox-list-container">
                                        [% FOREACH itemtype IN itemtypes %]
                                        <div class="koha-checkbox">
                                            <label>
                                                <input type="checkbox" name="warehouse_itemtypes" value="[% itemtype.itemtype | html %]" [% IF warehouse_itemtypes.grep('^' _ itemtype.itemtype _ '$').size %]checked="checked"[% END %] />
                                                <span class="checkbox-description">[% itemtype.translated_description | html %]</span>
                                            </label>
                                        </div>
                                        [% END %]
                                    </div>
                                </li>
                                
                                <!-- Sélection des statuts exclus du prêt -->
                                <li>
                                    <label><span data-i18n-key="ENABLED_ITEMSTATUS"></span>: </label>
                                    <div class="checkbox-list-container">
                                        [% FOREACH n IN notforloan %]
                                        <div class="koha-checkbox">
                                            <label>
                                                <input type="checkbox" name="warehouse_notforloan" value="[% n.code %]" [% IF warehouse_notforloan.grep('^' _ n.code _ '$').size %]checked="checked"[% END %] />
                                                <span class="checkbox-description">[% n.description | html %]</span>
                                            </label>
                                        </div>
                                        [% END %]
                                    </div>
                                </li>
                                
                                <li>
                                    <label for="warehouse_opac_enabled"><span data-i18n-key="PATRON_REQUEST"></span>: </label>
                                    <input name="warehouse_opac_enabled" id="warehouse_opac_enabled" value="1" type="checkbox" [% IF warehouse_opac_enabled %]checked="checked"[% END %] />
                                    <span class="hint"> Feature not enabled for now</span>
                                </li>
                                
                                <li>
                                    <label for="warehouse_waiting_enabled"><span data-i18n-key="ENABLED_WAITING"></span>: </label>
                                    <input name="warehouse_waiting_enabled" id="warehouse_waiting_enabled" value="1" type="checkbox" [% IF warehouse_waiting_enabled %]checked="checked"[% END %] />
                                </li>
                                
                                <li>
                                    <label for="warehouse_message_disabled"><span data-i18n-key="ALERT_IF_DISABLED"></span>: </label>
                                    <textarea name="warehouse_message_disabled" id="warehouse_message_disabled" rows="3" cols="40">[% warehouse_message_disabled %]</textarea>
                                    <span class="hint"> Feature not enabled for now</span>
                                </li>
                            </ol>
                        </fieldset>

                        <!-- Deuxième bloc : RabbitMQ Configuration -->
                        <fieldset class="rows">
                            <legend><h1 data-i18n-key="RABBITMQ_CONF"></h1></legend>
                            <ol>
                                <li>
                                    <label for="rmq_server"><span data-i18n-key="SERVER_LABEL"></span>: </label>
                                    <input type="text" id="rmq_server" name="rmq_server" value="[% rmq_server %]" />
                                </li>
                                <li>
                                    <label for="rmq_port"><span data-i18n-key="PORT_LABEL"></span>: </label>
                                    <input type="text" id="rmq_port" name="rmq_port" value="[% rmq_port %]" />
                                </li>
                                <li>
                                    <label for="rmq_vhost"><span data-i18n-key="VHOST_LABEL"></span>: </label>
                                    <input type="text" id="rmq_vhost" name="rmq_vhost" value="[% rmq_vhost %]" />
                                </li>
                                <li>
                                    <label for="rmq_exchange"><span data-i18n-key="EXCHANGE_LABEL"></span>: </label>
                                    <input type="text" id="rmq_exchange" name="rmq_exchange" value="[% rmq_exchange %]" />
                                </li>
                                <li>
                                    <label for="rmq_user"><span data-i18n-key="USER_LABEL"></span>: </label>
                                    <input type="text" id="rmq_user" name="rmq_user" value="[% rmq_user %]" />
                                </li>
                                <li>
                                    <label for="rmq_pwd"><span data-i18n-key="PWD_LABEL"></span>: </label>
                                    <input type="password" id="rmq_pwd" name="rmq_pwd" />
                                </li>
                                <li>
                                    <label for="rmq_pwd_conf"><span data-i18n-key="PWD_LABEL_CONFIRM"></span>: </label>
                                    <input type="password" id="rmq_pwd_conf" name="rmq_pwd_conf" />
                                </li>
                            </ol>
                        </fieldset>

                        <fieldset class="action">
                            <button type="submit" class="btn btn-primary">
                                <span data-i18n-key="SAVE_BUTTON"></span>
                            </button>
                        </fieldset>
                    </form>
                </main>
            </div>
        </div>
    </div>

[% MACRO jsinclude BLOCK %]

  <script type="text/javascript">

    var tokens = {};
    [% FOREACH t IN tokens %]
        tokens['[% t.key | html %]'] = [% t.text | $raw %];
    [% END %]

    console.log(tokens);

    $(document).ready(function() {
      var lang = $('html').attr('lang');
      var part = lang.split('-')[0];
      var i18n = Object.assign({}, tokens['en'], tokens[part]||{}, tokens[lang]||{});
      $('*[data-i18n-key]:not([data-i18n-key=""]').each(function(){
        var $t = $(this);
        var data = $t.data();
        if(!i18n.hasOwnProperty(data.i18nKey)) return;
        var text = _(i18n[data.i18nKey]);
        if(data.i18nFormat) {
            !Array.isArray(data.i18nFormat) && (data.i18nFormat = [data.i18nFormat]);
            text = text.format.apply(text, data.i18nFormat);
        }
        $t.html(text);
      });
    });

  </script>

[% END %]

[% INCLUDE 'intranet-bottom.inc' %]
